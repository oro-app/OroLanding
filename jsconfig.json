{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@newsletter-images/*": ["src/assets/newsletters/*"]
    },
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "checkJs": false,
    "allowJs": true
  },
  "include": ["src", "vite.config.js"],
  "exclude": ["node_modules", "dist"],
}
