{
  "buildCommand": "npm run build && mkdir -p dist/src && cp -R src/assets dist/src/",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/feedback(/.*)?",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/app/(terms|privacy)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app/(terms|privacy).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(terms|privacy|cookies|google-play)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(terms|privacy|cookies|google-play).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/src/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/:entry(beta|invite)", "has": [{ "type": "query", "key": "src", "value": "^poster-career(?:-[a-z0-9]+)*$" }], "destination": "/beta/career", "permanent": false },
    { "source": "/:entry(beta|invite)", "has": [{ "type": "query", "key": "src", "value": "^poster-dating(?:-[a-z0-9]+)*$" }], "destination": "/beta/dating", "permanent": false },
    { "source": "/journal",   "destination": "/from-the-closet", "permanent": true },
    { "source": "/manifesto", "destination": "/honestly",        "permanent": true }
  ],
  "rewrites": [
    { "source": "/beta/career", "destination": "/beta/career/index.html" },
    { "source": "/beta/dating", "destination": "/beta/dating/index.html" },
    { "source": "/beta", "destination": "/beta/index.html" },
    { "source": "/invite", "destination": "/beta/index.html" },
    { "source": "/feedback", "destination": "/feedback/index.html" },
    { "source": "/app/terms", "destination": "/app/terms.html" },
    { "source": "/app/privacy", "destination": "/app/privacy.html" },
    { "source": "/app", "destination": "/api/app" },
    { "source": "/terms",   "destination": "/terms.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/cookies", "destination": "/cookies.html" },
    { "source": "/google-play", "destination": "/google-play.html" },
    { "source": "/((?!api/)(?!.*\\.).*)", "destination": "/index.html" }
  ]
}
