{
  "buildCommand": "npm run build && mkdir -p dist/src && cp -R src/assets dist/src/",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<preview>.*\\.vercel\\.app)"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(terms|privacy|cookies|google-play)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(terms|privacy|cookies|google-play).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/src/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/journal",
      "destination": "/from-the-closet",
      "permanent": true
    },
    {
      "source": "/try-oro",
      "destination": "/get-started",
      "permanent": true
    },
    {
      "source": "/how-it-works",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/why-oro",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/honestly",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/manifesto",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/api/app"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/cookies",
      "destination": "/cookies.html"
    },
    {
      "source": "/google-play",
      "destination": "/google-play.html"
    },
    {
      "source": "/((?!api/)(?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
