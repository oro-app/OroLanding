{
  "buildCommand": "npm run build && mkdir -p dist/src && cp -R src/assets dist/src/",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/design-system(/.*)?",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/closet(/.*)?",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src https:; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" }
      ]
    },
    {
      "source": "/merch",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/checkout(/.*)?",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/feedback(/.*)?",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/app/(terms|privacy)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app/(terms|privacy).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(terms|privacy|cookies|google-play)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(terms|privacy|cookies|google-play).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/src/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/beta/:path*", "destination": "/", "permanent": true },
    { "source": "/invite", "destination": "/", "permanent": true },
    { "source": "/tester/referrals", "destination": "/", "permanent": true },
    { "source": "/getstarted", "destination": "/", "permanent": true },
    { "source": "/get-started/:path*", "destination": "/", "permanent": true },
    { "source": "/meet-oro", "destination": "/", "permanent": true },
    { "source": "/putty", "destination": "/merch", "permanent": true },
    { "source": "/journal",   "destination": "/from-the-closet", "permanent": true },
    { "source": "/manifesto", "destination": "/honestly",        "permanent": true }
  ],
  "rewrites": [
    { "source": "/design-system", "destination": "/design-system/index.html" },
    { "source": "/design-system/", "destination": "/design-system/index.html" },
    { "source": "/checkout", "destination": "/checkout/index.html" },
    { "source": "/closet", "destination": "/closet/index.html" },
    { "source": "/merch", "destination": "/merch/index.html" },
    { "source": "/feedback", "destination": "/feedback/index.html" },
    { "source": "/app/terms", "destination": "/app/terms.html" },
    { "source": "/app/privacy", "destination": "/app/privacy.html" },
    { "source": "/app", "destination": "/api/app" },
    { "source": "/terms",   "destination": "/terms.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/cookies", "destination": "/cookies.html" },
    { "source": "/google-play", "destination": "/google-play.html" },
    { "source": "/((?!api/)(?!signup/?$)(?!design-system(?:/|$))(?!.*\\.).*)", "destination": "/index.html" }
  ]
}
