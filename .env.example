# Vercel environment variables for oro-landing (buildingoro.ca).
# Set these in the Vercel dashboard → Project → Settings → Environment Variables.

# Supabase — use the SERVICE ROLE key (not anon) so the unsubscribe endpoint can write.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# HMAC secret for unsubscribe tokens — must match UNSUBSCRIBE_SECRET in oro-newsletter/.env.local.
# Generate with: openssl rand -base64 48
UNSUBSCRIBE_SECRET=

# Contact form (api/contact.js). RESEND_API_KEY = same key oro-newsletter uses
# (buildingoro.ca is already a verified Resend domain). Set in BOTH the
# Production AND Preview env scopes, or the preview deployment can't email.
RESEND_API_KEY=
# Optional overrides — defaults are admin@buildingoro.ca / "Oro Contact <admin@buildingoro.ca>".
CONTACT_TO_EMAIL=admin@buildingoro.ca
CONTACT_FROM_EMAIL=Oro Contact <admin@buildingoro.ca>
VITE_ORO_API_URL=https://api.buildingoro.ca